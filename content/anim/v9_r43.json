[
 {
  "id": "ssh-handshake",
  "concept": "ssh",
  "title": "An SSH handshake, login and a host-key warning",
  "w": 720,
  "h": 400,
  "groups": [],
  "actors": [
   {
    "id": "cl",
    "label": "ssh client",
    "x": 30,
    "y": 120,
    "w": 150,
    "h": 86,
    "shape": "box",
    "sub": "user dev"
   },
   {
    "id": "sv",
    "label": "sshd server",
    "x": 540,
    "y": 120,
    "w": 150,
    "h": 86,
    "shape": "box",
    "sub": "port 22"
   },
   {
    "id": "kh",
    "label": "known_hosts",
    "x": 30,
    "y": 290,
    "w": 150,
    "h": 56,
    "shape": "note",
    "sub": "build1: key A"
   },
   {
    "id": "ak",
    "label": "authorized_keys",
    "x": 540,
    "y": 290,
    "w": 150,
    "h": 56,
    "shape": "note",
    "sub": "dev: key B"
   }
  ],
  "links": [
   {
    "from": "cl",
    "to": "sv",
    "label": "",
    "dashed": false
   }
  ],
  "steps": [
   {
    "say": "TCP is connected. Each side sends one line of plain text with its software version. No key exists yet.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "SSH-2.0-OpenSSH_10",
      "tone": "normal"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "SSH-2.0-OpenSSH_10",
      "tone": "normal"
     }
    ],
    "set": {
     "cl": {
      "sub": "TCP up, no keys"
     },
     "sv": {
      "sub": "TCP up, no keys"
     }
    }
   },
   {
    "say": "Both send KEXINIT: ordered lists of key exchange, cipher and MAC names. The first client choice the server also knows wins.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "KEXINIT lists",
      "tone": "normal"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "KEXINIT lists",
      "tone": "normal"
     }
    ],
    "set": {
     "cl": {
      "sub": "mlkem768x25519"
     },
     "sv": {
      "sub": "mlkem768x25519"
     }
    }
   },
   {
    "say": "The client sends a fresh temporary public key Q_C (X25519 plus ML-KEM-768). It is used once and then thrown away.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "Q_C temp key",
      "tone": "accent"
     }
    ],
    "set": {
     "cl": {
      "sub": "made temp key",
      "tone": "accent"
     }
    }
   },
   {
    "say": "The server answers with Q_S, its host key and a signature over H, the hash of everything said so far. Both sides now compute the same secret K, which never crossed the wire.",
    "msgs": [
     {
      "from": "sv",
      "to": "cl",
      "label": "host key, Q_S, sign(H)",
      "tone": "accent"
     }
    ],
    "set": {
     "cl": {
      "sub": "has secret K",
      "tone": "ok"
     },
     "sv": {
      "sub": "has secret K",
      "tone": "ok"
     }
    }
   },
   {
    "say": "The client checks the host key against known_hosts and verifies the signature. This proves the server holds the private key and took part in this exchange.",
    "msgs": [
     {
      "from": "cl",
      "to": "kh",
      "label": "same key?",
      "tone": "accent"
     }
    ],
    "set": {
     "kh": {
      "sub": "build1: key A, match",
      "tone": "ok"
     },
     "cl": {
      "sub": "server verified",
      "tone": "ok"
     }
    }
   },
   {
    "say": "NEWKEYS: keys are derived by hashing K and H. From here every packet has a 16-byte tag and a hidden length.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "NEWKEYS",
      "tone": "ok"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "NEWKEYS",
      "tone": "ok"
     }
    ],
    "set": {
     "cl": {
      "sub": "encrypted"
     },
     "sv": {
      "sub": "encrypted"
     }
    }
   },
   {
    "say": "User authentication. The client asks with method none and learns that publickey is allowed. Then it offers its public key.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "auth: none",
      "tone": "normal"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "try publickey",
      "tone": "normal"
     },
     {
      "from": "cl",
      "to": "sv",
      "label": "offer key B",
      "tone": "normal"
     }
    ],
    "set": {
     "sv": {
      "sub": "encrypted, user dev?"
     }
    }
   },
   {
    "say": "The server looks the key up in authorized_keys and says yes. The key is listed, but ownership is not proved yet.",
    "msgs": [
     {
      "from": "sv",
      "to": "ak",
      "label": "lookup key B",
      "tone": "accent"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "PK_OK",
      "tone": "ok"
     }
    ],
    "set": {
     "ak": {
      "sub": "dev: key B found",
      "tone": "ok"
     }
    }
   },
   {
    "say": "The client signs a message that contains the session ID, so the signature is valid only on this connection. No password is sent.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "signature (64 B)",
      "tone": "accent"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "SUCCESS",
      "tone": "ok"
     }
    ],
    "set": {
     "sv": {
      "sub": "dev logged in",
      "tone": "ok"
     }
    }
   },
   {
    "say": "Now a channel opens, with a 2 MiB window: the sender may send 2 MiB before the receiver must give more credit.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "CHANNEL_OPEN, window 2 MiB",
      "tone": "normal"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "CONFIRM",
      "tone": "normal"
     }
    ],
    "set": {
     "cl": {
      "sub": "channel 0 open"
     }
    }
   },
   {
    "say": "The client asks for a terminal and a shell. Each key you type is one small encrypted packet, about 40 bytes of SSH data.",
    "msgs": [
     {
      "from": "cl",
      "to": "sv",
      "label": "pty-req, shell",
      "tone": "normal"
     },
     {
      "from": "sv",
      "to": "cl",
      "label": "prompt (encrypted)",
      "tone": "ok"
     }
    ],
    "set": {
     "cl": {
      "sub": "shell running",
      "tone": "ok"
     },
     "sv": {
      "sub": "shell for dev",
      "tone": "ok"
     }
    }
   },
   {
    "say": "Failure: next week someone sits in the path. The server's host key is key X, not key A, and the signature is by X.",
    "msgs": [
     {
      "from": "sv",
      "to": "cl",
      "label": "host key X, sign(H)",
      "tone": "bad"
     }
    ],
    "set": {
     "sv": {
      "sub": "attacker, key X",
      "tone": "bad"
     },
     "cl": {
      "sub": "new connection"
     }
    }
   },
   {
    "say": "The key differs from known_hosts. ssh prints a loud warning and closes the connection before any password or signature is sent.",
    "msgs": [
     {
      "from": "cl",
      "to": "kh",
      "label": "same key?",
      "tone": "bad"
     }
    ],
    "set": {
     "kh": {
      "sub": "key A != key X",
      "tone": "bad"
     },
     "cl": {
      "sub": "REFUSED",
      "tone": "bad"
     }
    }
   }
  ]
 },
 {
  "id": "dhcp-dora",
  "concept": "dhcp",
  "title": "DHCP gives a phone an address, then renews it",
  "w": 720,
  "h": 400,
  "groups": [],
  "actors": [
   {
    "id": "cl",
    "label": "Phone",
    "x": 30,
    "y": 150,
    "w": 150,
    "h": 90,
    "shape": "box",
    "sub": "no IP yet"
   },
   {
    "id": "sa",
    "label": "DHCP server A",
    "x": 540,
    "y": 50,
    "w": 160,
    "h": 80,
    "shape": "box",
    "sub": "pool .20-.200"
   },
   {
    "id": "sb",
    "label": "DHCP server B",
    "x": 540,
    "y": 270,
    "w": 160,
    "h": 80,
    "shape": "box",
    "sub": "pool .20-.200"
   },
   {
    "id": "lc",
    "label": "Lease clock",
    "x": 30,
    "y": 300,
    "w": 150,
    "h": 56,
    "shape": "note",
    "sub": "not started"
   }
  ],
  "links": [
   {
    "from": "cl",
    "to": "sa",
    "label": "",
    "dashed": false
   },
   {
    "from": "cl",
    "to": "sb",
    "label": "",
    "dashed": false
   }
  ],
  "steps": [
   {
    "say": "The phone has joined the Wi-Fi link but has no IP address. It broadcasts DISCOVER from 0.0.0.0 to 255.255.255.255, UDP port 67, with a random transaction ID.",
    "msgs": [
     {
      "from": "cl",
      "to": "sa",
      "label": "DISCOVER xid=3F2A",
      "tone": "accent"
     },
     {
      "from": "cl",
      "to": "sb",
      "label": "DISCOVER xid=3F2A",
      "tone": "accent"
     }
    ],
    "set": {
     "cl": {
      "sub": "0.0.0.0, asking",
      "tone": "accent"
     }
    }
   },
   {
    "say": "Server A picks a free address, 192.168.1.23, holds it for a few seconds and offers it with a 24 hour lease, the mask, gateway and DNS.",
    "msgs": [
     {
      "from": "sa",
      "to": "cl",
      "label": "OFFER .23, 24 h",
      "tone": "accent"
     }
    ],
    "set": {
     "sa": {
      "sub": "holding .23 for phone",
      "tone": "accent"
     }
    }
   },
   {
    "say": "Server B also answers, with .87. Two offers arrive. The phone takes the first one it received.",
    "msgs": [
     {
      "from": "sb",
      "to": "cl",
      "label": "OFFER .87, 24 h",
      "tone": "muted"
     }
    ],
    "set": {
     "sb": {
      "sub": "holding .87 for phone",
      "tone": "muted"
     }
    }
   },
   {
    "say": "The phone broadcasts REQUEST naming server A and address .23. It is a broadcast so that server B also hears that it was not chosen.",
    "msgs": [
     {
      "from": "cl",
      "to": "sa",
      "label": "REQUEST .23 from A",
      "tone": "accent"
     },
     {
      "from": "cl",
      "to": "sb",
      "label": "REQUEST .23 from A",
      "tone": "muted"
     }
    ],
    "set": {
     "sb": {
      "sub": "offer released",
      "tone": "normal"
     }
    }
   },
   {
    "say": "Server A saves the binding (phone MAC, .23, expiry) and only then sends ACK with all options.",
    "msgs": [
     {
      "from": "sa",
      "to": "cl",
      "label": "ACK .23, gw, DNS",
      "tone": "ok"
     }
    ],
    "set": {
     "sa": {
      "sub": "lease saved: .23, 24 h",
      "tone": "ok"
     },
     "cl": {
      "sub": "192.168.1.23",
      "tone": "ok"
     },
     "lc": {
      "sub": "24 h: T1 12 h, T2 21 h",
      "tone": "ok"
     }
    }
   },
   {
    "say": "Before using the address, the phone sends an ARP probe asking who has .23. Silence means it is free. Total time so far is roughly 50 to 200 ms.",
    "set": {
     "cl": {
      "sub": "ARP: no reply, use it",
      "tone": "ok"
     }
    },
    "focus": [
     "cl"
    ]
   },
   {
    "say": "After 12 hours (T1, half the lease) the phone sends a unicast REQUEST to server A. The ACK restarts the clock at 24 hours. Nobody notices.",
    "msgs": [
     {
      "from": "cl",
      "to": "sa",
      "label": "REQUEST (renew)",
      "tone": "normal"
     },
     {
      "from": "sa",
      "to": "cl",
      "label": "ACK, 24 h more",
      "tone": "ok"
     }
    ],
    "set": {
     "lc": {
      "sub": "renewed, T1 in 12 h",
      "tone": "ok"
     }
    }
   },
   {
    "say": "Another day, server A has crashed. At T1 the renewal gets no answer. The phone keeps its address and retries.",
    "msgs": [
     {
      "from": "cl",
      "to": "sa",
      "label": "REQUEST (renew)",
      "tone": "bad",
      "lost": true
     }
    ],
    "set": {
     "sa": {
      "sub": "down",
      "tone": "bad"
     },
     "lc": {
      "sub": "T1 passed, no ACK",
      "tone": "warn"
     }
    }
   },
   {
    "say": "At T2 (87.5% of the lease, hour 21) the phone broadcasts to any server. Server B answers and extends the lease, so the outage never reached the user.",
    "msgs": [
     {
      "from": "cl",
      "to": "sb",
      "label": "REQUEST (rebind)",
      "tone": "warn"
     },
     {
      "from": "sb",
      "to": "cl",
      "label": "ACK, new lease",
      "tone": "ok"
     }
    ],
    "set": {
     "sb": {
      "sub": "now serves phone",
      "tone": "ok"
     },
     "lc": {
      "sub": "rebound at T2",
      "tone": "ok"
     }
    }
   },
   {
    "say": "If nobody had answered before hour 24, the phone would have to drop 192.168.1.23 and restart from DISCOVER. A long lease gives the server time to be repaired.",
    "set": {
     "lc": {
      "sub": "hour 24: drop address",
      "tone": "bad"
     },
     "cl": {
      "sub": "would restart DISCOVER",
      "tone": "warn"
     }
    }
   }
  ]
 },
 {
  "id": "wifi-csma-backoff",
  "concept": "wifi",
  "title": "Wi-Fi stations take turns with random backoff",
  "w": 720,
  "h": 400,
  "groups": [],
  "actors": [
   {
    "id": "a",
    "label": "Station A",
    "x": 30,
    "y": 40,
    "w": 140,
    "h": 66,
    "shape": "box",
    "sub": "has data"
   },
   {
    "id": "b",
    "label": "Station B",
    "x": 30,
    "y": 260,
    "w": 140,
    "h": 66,
    "shape": "box",
    "sub": "has data"
   },
   {
    "id": "c",
    "label": "Station C",
    "x": 550,
    "y": 150,
    "w": 140,
    "h": 66,
    "shape": "box",
    "sub": "has data"
   },
   {
    "id": "ap",
    "label": "Access point",
    "x": 290,
    "y": 150,
    "w": 140,
    "h": 80,
    "shape": "box",
    "sub": "one channel"
   },
   {
    "id": "ch",
    "label": "Channel",
    "x": 270,
    "y": 320,
    "w": 180,
    "h": 56,
    "shape": "note",
    "sub": "idle"
   }
  ],
  "links": [
   {
    "from": "a",
    "to": "ap",
    "label": "",
    "dashed": false
   },
   {
    "from": "b",
    "to": "ap",
    "label": "",
    "dashed": false
   },
   {
    "from": "c",
    "to": "ap",
    "label": "",
    "dashed": false
   }
  ],
  "steps": [
   {
    "say": "The channel has been idle for DIFS, 34 microseconds. Each station with data draws a random backoff of 0 to 15 slots (a slot is 9 microseconds). A draws 3, B draws 6, C draws 11.",
    "set": {
     "a": {
      "sub": "backoff 3",
      "tone": "accent"
     },
     "b": {
      "sub": "backoff 6",
      "tone": "accent"
     },
     "c": {
      "sub": "backoff 11",
      "tone": "accent"
     },
     "ch": {
      "sub": "idle 34 us"
     }
    }
   },
   {
    "say": "All count down, one per idle slot. After 3 slots A reaches zero and sends a frame. B and C hear it, so they freeze their counters at 3 and 8.",
    "msgs": [
     {
      "from": "a",
      "to": "ap",
      "label": "DATA 1500 B",
      "tone": "accent"
     }
    ],
    "set": {
     "a": {
      "sub": "sending",
      "tone": "accent"
     },
     "b": {
      "sub": "frozen at 3",
      "tone": "warn"
     },
     "c": {
      "sub": "frozen at 8",
      "tone": "warn"
     },
     "ch": {
      "sub": "busy",
      "tone": "warn"
     }
    }
   },
   {
    "say": "The AP sends an ACK after SIFS, 16 microseconds. SIFS is shorter than DIFS, so nobody can cut in before the ACK. Without an ACK the sender would assume the frame was lost.",
    "msgs": [
     {
      "from": "ap",
      "to": "a",
      "label": "ACK",
      "tone": "ok"
     }
    ],
    "set": {
     "a": {
      "sub": "done, ACK received",
      "tone": "ok"
     },
     "ch": {
      "sub": "idle again",
      "tone": "normal"
     }
    }
   },
   {
    "say": "After DIFS, B and C resume. B counts its last 3 slots and sends. C freezes again, at 5.",
    "msgs": [
     {
      "from": "b",
      "to": "ap",
      "label": "DATA 1500 B",
      "tone": "accent"
     }
    ],
    "set": {
     "b": {
      "sub": "sending",
      "tone": "accent"
     },
     "c": {
      "sub": "frozen at 5",
      "tone": "warn"
     },
     "ch": {
      "sub": "busy",
      "tone": "warn"
     }
    }
   },
   {
    "say": "ACK for B. Each frame costs a fixed waiting overhead of about 100 to 200 microseconds, so with many stations most of the time goes to waiting, not to data.",
    "msgs": [
     {
      "from": "ap",
      "to": "b",
      "label": "ACK",
      "tone": "ok"
     }
    ],
    "set": {
     "b": {
      "sub": "done",
      "tone": "ok"
     },
     "ch": {
      "sub": "idle again",
      "tone": "normal"
     }
    }
   },
   {
    "say": "Collision: later B and C both draw 4 and reach zero in the same slot. They cannot hear each other while sending, so both transmit and the AP hears garbage.",
    "msgs": [
     {
      "from": "b",
      "to": "ap",
      "label": "DATA",
      "tone": "bad",
      "lost": true
     },
     {
      "from": "c",
      "to": "ap",
      "label": "DATA",
      "tone": "bad",
      "lost": true
     }
    ],
    "set": {
     "b": {
      "sub": "drew 4",
      "tone": "bad"
     },
     "c": {
      "sub": "drew 4",
      "tone": "bad"
     },
     "ch": {
      "sub": "collision",
      "tone": "bad"
     }
    }
   },
   {
    "say": "No ACK comes. After the timeout both double their contention window from 15 to 31 and draw again, independently. B draws 17 and C draws 9.",
    "set": {
     "b": {
      "sub": "CW 31, draw 17",
      "tone": "warn"
     },
     "c": {
      "sub": "CW 31, draw 9",
      "tone": "warn"
     },
     "ch": {
      "sub": "idle",
      "tone": "normal"
     }
    }
   },
   {
    "say": "C counts down first and sends. B freezes at 8. Random numbers broke the tie with no coordination and no messages.",
    "msgs": [
     {
      "from": "c",
      "to": "ap",
      "label": "DATA 1500 B",
      "tone": "accent"
     },
     {
      "from": "ap",
      "to": "c",
      "label": "ACK",
      "tone": "ok"
     }
    ],
    "set": {
     "c": {
      "sub": "done after retry",
      "tone": "ok"
     },
     "b": {
      "sub": "frozen at 8",
      "tone": "warn"
     }
    }
   },
   {
    "say": "Hidden terminal: A (far left) and C (far right) are too far apart to hear each other, but both hear the AP. Each sees an idle channel and they start together.",
    "msgs": [
     {
      "from": "a",
      "to": "ap",
      "label": "DATA",
      "tone": "bad",
      "lost": true
     },
     {
      "from": "c",
      "to": "ap",
      "label": "DATA",
      "tone": "bad",
      "lost": true
     }
    ],
    "set": {
     "a": {
      "sub": "cannot hear C",
      "tone": "bad"
     },
     "c": {
      "sub": "cannot hear A",
      "tone": "bad"
     },
     "ch": {
      "sub": "collision at AP",
      "tone": "bad"
     }
    }
   },
   {
    "say": "Fix for big frames: A first sends a short RTS. The AP answers CTS, which every station in range hears, including C.",
    "msgs": [
     {
      "from": "a",
      "to": "ap",
      "label": "RTS",
      "tone": "accent"
     },
     {
      "from": "ap",
      "to": "a",
      "label": "CTS",
      "tone": "ok"
     },
     {
      "from": "ap",
      "to": "c",
      "label": "CTS (reserve time)",
      "tone": "ok"
     }
    ],
    "set": {
     "c": {
      "sub": "NAV set: wait",
      "tone": "warn"
     },
     "a": {
      "sub": "channel reserved",
      "tone": "ok"
     },
     "ch": {
      "sub": "reserved for A",
      "tone": "accent"
     }
    }
   },
   {
    "say": "C's NAV timer counts the reserved time, so C stays quiet even though it hears nothing. A sends its data and gets the ACK without a collision.",

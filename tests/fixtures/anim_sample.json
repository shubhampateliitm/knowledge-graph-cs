[
 {"id": "sample-tcp-handshake", "concept": "tcp", "title": "Handshake with a lost SYN-ACK",
  "w": 720, "h": 400,
  "groups": [
    {"id": "gc", "label": "Client host", "x": 20, "y": 20, "w": 220, "h": 360},
    {"id": "gn", "label": "Network", "x": 260, "y": 20, "w": 200, "h": 360},
    {"id": "gs", "label": "Server host", "x": 480, "y": 20, "w": 220, "h": 360}],
  "actors": [
    {"id": "c", "label": "Client socket", "sub": "CLOSED", "x": 50, "y": 70, "w": 160, "h": 60, "shape": "round", "tone": "muted"},
    {"id": "s", "label": "Server socket", "sub": "LISTEN :443", "x": 510, "y": 70, "w": 160, "h": 60, "shape": "round"},
    {"id": "q", "label": "Accept queue", "sub": "empty", "x": 510, "y": 190, "w": 160, "h": 70, "shape": "db"},
    {"id": "app", "label": "Web server", "sub": "blocked in accept()", "x": 510, "y": 300, "w": 160, "h": 56, "shape": "box", "tone": "muted"}],
  "links": [{"from": "q", "to": "app", "label": "", "dashed": true}],
  "steps": [
    {"say": "The server has called listen() on port 443 and is waiting. The client has no connection yet.",
     "focus": ["s"]},
    {"say": "The client sends SYN with a random start number, seq=1000, and starts a retransmit timer of 1 second.",
     "msgs": [{"from": "c", "to": "s", "label": "SYN seq=1000", "tone": "accent"}],
     "set": {"c": {"sub": "SYN_SENT", "tone": "accent"}},
     "add": [{"id": "rto", "label": "Retransmit timer", "sub": "fires in 1 s", "x": 50, "y": 190, "w": 160, "h": 60, "shape": "note", "tone": "warn"}]},
    {"say": "The server answers SYN-ACK (seq=5000, ack=1001) and remembers the half-open connection. A router drops the packet: the client never sees it.",
     "msgs": [{"from": "s", "to": "c", "label": "SYN-ACK seq=5000", "tone": "bad", "lost": true}],
     "set": {"s": {"sub": "SYN_RCVD", "tone": "warn"}}},
    {"say": "No answer within 1 second, so the client's timer fires. It sends the same SYN again and doubles the timeout to 2 seconds.",
     "msgs": [{"from": "c", "to": "s", "label": "SYN seq=1000 (again)", "tone": "warn"}],
     "set": {"rto": {"sub": "fired; next in 2 s"}},
     "focus": ["rto"]},
    {"say": "The server sees a duplicate SYN and resends its SYN-ACK. This time it arrives, so the client is connected and stops the timer.",
     "msgs": [{"from": "s", "to": "c", "label": "SYN-ACK seq=5000", "tone": "accent"}],
     "set": {"c": {"sub": "ESTABLISHED", "tone": "ok"}},
     "remove": ["rto"]},
    {"say": "The client sends the last ACK (ack=5001). The server is connected too and puts the new connection in the accept queue.",
     "msgs": [{"from": "c", "to": "s", "label": "ACK ack=5001", "tone": "ok"}],
     "set": {"s": {"sub": "ESTABLISHED", "tone": "ok"}, "q": {"sub": "1 connection", "tone": "ok"}},
     "link": [{"from": "c", "to": "s", "label": "connection", "dashed": false}]},
    {"say": "accept() returns the connection to the web server. One lost packet added a full second before the first byte: this is why handshakes hurt on lossy mobile links.",
     "msgs": [{"from": "q", "to": "app", "label": "accept() = fd 7", "tone": "ok"}],
     "set": {"q": {"sub": "empty", "tone": "normal"}, "app": {"sub": "serving fd 7", "tone": "ok"}},
     "focus": ["app"]}]},

 {"id": "sample-lru-eviction", "concept": "eviction", "title": "LRU evicts the coldest key",
  "w": 720, "h": 400,
  "groups": [{"id": "list", "label": "LRU list (top = most recent)", "x": 390, "y": 20, "w": 310, "h": 310}],
  "actors": [
    {"id": "app", "label": "App server", "sub": "", "x": 30, "y": 160, "w": 130, "h": 56, "shape": "box"},
    {"id": "idx", "label": "Hash map", "sub": "4 of 4 keys", "x": 210, "y": 160, "w": 130, "h": 56, "shape": "round"},
    {"id": "db", "label": "Postgres", "sub": "source of truth", "x": 210, "y": 300, "w": 130, "h": 80, "shape": "db"},
    {"id": "u7", "label": "user:7", "sub": "", "x": 420, "y": 60, "w": 250, "h": 48, "shape": "cell"},
    {"id": "u3", "label": "user:3", "sub": "", "x": 420, "y": 125, "w": 250, "h": 48, "shape": "cell"},
    {"id": "u9", "label": "user:9", "sub": "", "x": 420, "y": 190, "w": 250, "h": 48, "shape": "cell"},
    {"id": "u2", "label": "user:2", "sub": "least recent", "x": 420, "y": 255, "w": 250, "h": 48, "shape": "cell", "tone": "warn"}],
  "links": [
    {"from": "app", "to": "idx", "label": "", "dashed": false},
    {"from": "app", "to": "db", "label": "on a miss", "dashed": true}],
  "steps": [
    {"say": "The cache holds 4 keys, ordered by last use. user:2 has gone longest without a read, so it is next in line to be evicted.",
     "focus": ["u2"]},
    {"say": "GET user:9 is a hit: the hash map finds it in about 0.1 ms, and user:9 moves to the top of the list.",
     "msgs": [{"from": "app", "to": "idx", "label": "GET user:9"}, {"from": "idx", "to": "app", "label": "hit", "tone": "ok"}],
     "move": {"u9": {"x": 420, "y": 60}, "u7": {"x": 420, "y": 125}, "u3": {"x": 420, "y": 190}},
     "set": {"u9": {"sub": "just used", "tone": "ok"}}},
    {"say": "GET user:5 is a miss, so the app reads the row from Postgres (about 2 ms, 20 times slower than a hit).",
     "msgs": [{"from": "app", "to": "idx", "label": "GET user:5"}, {"from": "idx", "to": "app", "label": "miss", "tone": "bad"},
              {"from": "app", "to": "db", "label": "SELECT user:5"}, {"from": "db", "to": "app", "label": "row (2 ms)"}],
     "set": {"u9": {"sub": "", "tone": "normal"}, "idx": {"sub": "miss: user:5", "tone": "bad"}}},
    {"say": "The cache is full, so to make room it evicts the least recently used key, user:2, from the list and the hash map.",
     "remove": ["u2"],
     "set": {"idx": {"sub": "3 of 4 keys", "tone": "warn"}}},
    {"say": "user:5 goes in at the top as the most recently used key; every other key slides down one place.",
     "msgs": [{"from": "app", "to": "idx", "label": "PUT user:5", "tone": "accent"}],
     "move": {"u9": {"x": 420, "y": 125}, "u7": {"x": 420, "y": 190}, "u3": {"x": 420, "y": 255}},
     "add": [{"id": "u5", "label": "user:5", "sub": "just added", "x": 420, "y": 60, "w": 250, "h": 48, "shape": "cell", "tone": "ok"}],
     "set": {"idx": {"sub": "4 of 4 keys", "tone": "normal"}}},
    {"say": "GET user:3 is a hit, so user:3 jumps to the top. Now user:7 is the coldest key and would be evicted next.",
     "msgs": [{"from": "app", "to": "idx", "label": "GET user:3"}, {"from": "idx", "to": "app", "label": "hit", "tone": "ok"}],
     "move": {"u3": {"x": 420, "y": 60}, "u5": {"x": 420, "y": 125}, "u9": {"x": 420, "y": 190}, "u7": {"x": 420, "y": 255}},
     "set": {"u5": {"sub": "", "tone": "normal"}, "u3": {"sub": "just used", "tone": "ok"}, "u7": {"sub": "least recent", "tone": "warn"}}},
    {"say": "Each GET and PUT is O(1): the hash map finds the list node, and a doubly linked list moves it to the top in constant time. Here: 2 hits, 1 miss, 1 eviction.",
     "set": {"u3": {"sub": "", "tone": "normal"}},
     "focus": ["idx"]}]}
]
